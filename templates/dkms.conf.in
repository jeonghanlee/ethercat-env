# EtherCAT master DKMS configuration.
#
# GENERATED FILE - do not edit by hand.
# Rendered by `make dkms.conf` from templates/dkms.conf.in.
# Source identity comes from configure/CONFIG_MODULE (MODULE_NAME, MODULE_VERSION)
# and the resolved device profile (selected WITH_DEV_* drivers).
#
# Delegated decision D1: DKMS is the recorded production lifecycle so the
# EtherCAT kernel modules auto-rebuild on a Debian 13 kernel update.

PACKAGE_NAME="@MODULE_NAME@"
PACKAGE_VERSION="@MODULE_VERSION@"

# Build the modules out of the upstream tree. autoreconf + configure run during
# `make autoconf`; DKMS invokes the kernel module build for the running kernel.
MAKE[0]="make modules KDIR=/lib/modules/${kernelver}/build"
CLEAN="make clean"

# Built module set. Index 0 is the always-present master module; the device
# driver entries below are emitted by `make dkms.conf` for each enabled profile.
BUILT_MODULE_NAME[0]="ec_master"
BUILT_MODULE_LOCATION[0]="master"
DEST_MODULE_LOCATION[0]="/kernel/drivers/ethercat"

@BUILT_DEVICE_MODULES@

AUTOINSTALL="yes"
