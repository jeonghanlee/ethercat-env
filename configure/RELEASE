
APPNAME:=ethercat

## Where the Source repository SRC_URL/SRC_NAME
#
SRC_URL:=https://gitlab.com/etherlab.org
SRC_NAME:=${APPNAME}

## Which source tag, branch, or hash id to use
SRC_TAG:=stable-1.6

# Pinned expected revision of the moving stable-1.6 branch.
# "git -C $(SRC_PATH) describe --tags" must report this for src.verify to pass.
# If upstream advances the branch, src.verify fails by design; bump this
# consciously rather than letting the pin drift silently.
SRC_HASH:=1.6.9-4-g46cc20e6

# Checksum of the UNCOMPRESSED orig tar stream generated by pkg.orig
# (git archive --format=tar at the pin). Binds content, not the gzip layer,
# which is not byte-stable across git versions. pkg.orig.verify fails closed
# on mismatch; recompute with "make pkg.orig.checksum" when SRC_HASH bumps.
ORIG_SHA256:=cacae0c36bce65bf16f4919a606e1aca7f856189004e1128ff95ee5a9820f156

# Placeholder for the site-specific version control
SRC_VERSION=${SRC_TAG}

# Repository-local default for the .versions staging path. Must be non-empty
# and absolute (guard-path enforces this) so the .versions write never lands
# at the filesystem root. A site override may point this elsewhere via
# RELEASE.local.
SITE_TEMPLATE_PATH:=$(TOP)
SITE_VERSION_FILE ?= $(SITE_TEMPLATE_PATH)/.versions
SITE_VERSION_GUARD ?= $(TOP)/.versions


-include $(TOP)/../RELEASE.local
-include $(TOP)/configure/RELEASE.local
