# RULES_RUNTIME - runtime ethercat.conf generator, lint, and NIC status (M9).
#
# runtime.generate renders templates/ethercat.conf.in into a REPOSITORY-LOCAL
# output path. It never writes to /etc/ethercat.conf; installation into /etc is
# an M10 root-affecting concern, kept out of this file. Generation, lint, config
# show, and iface.status are all non-root.
#
# iface.prepare is the root-affecting NIC up/down target. It is wired to require
# doctor + require-root and is declared here, but its actual execution belongs to
# the later root-affecting phase. On this non-root, no-host-mutation pass it
# refuses to act on an empty/unresolved interface and depends on doctor.
#
# Data flow
# ---------
#   configure/ethercatmaster.conf : ETHERCAT_MASTER0 (master interface name)
#   selected profile (WITH_DEV_*)  : enabled drivers -> DEVICE_MODULES
#   -> templates/ethercat.conf.in  -> $(RUNTIME_OUTPUT)  (repo-local)

.PHONY: runtime.generate runtime.lint runtime.config.show iface.status iface.prepare iface.unprepare

# Repo-local render target. NEVER /etc. Overridable via RULES_RUNTIME.local.
RUNTIME_TEMPLATE ?= $(TOP)/templates/ethercat.conf.in
RUNTIME_BUILD    ?= $(TOP)/build
RUNTIME_OUTPUT   ?= $(RUNTIME_BUILD)/ethercat.conf

# Resolved master interface name, quotes stripped from ETHERCAT_MASTER0.
RUNTIME_MASTER0  := $(patsubst "%",%,$(ETHERCAT_MASTER0))
RUNTIME_BACKUP   ?=
# Interfaces brought up/down track the master interface by default.
RUNTIME_UPDOWN   ?= $(RUNTIME_MASTER0)

# DEVICE_MODULES: the enabled WITH_DEV_* drivers, in profile order. Each token is
# emitted only when its selector resolves to YES.
RUNTIME_MODULES :=
ifeq ($(WITH_DEV_GENERIC),YES)
RUNTIME_MODULES += generic
endif
ifeq ($(WITH_DEV_8139TOO),YES)
RUNTIME_MODULES += 8139too
endif
ifeq ($(WITH_DEV_E100),YES)
RUNTIME_MODULES += e100
endif
ifeq ($(WITH_DEV_E1000),YES)
RUNTIME_MODULES += e1000
endif
ifeq ($(WITH_DEV_E1000E),YES)
RUNTIME_MODULES += e1000e
endif
ifeq ($(WITH_DEV_IGB),YES)
RUNTIME_MODULES += igb
endif
ifeq ($(WITH_DEV_R8169),YES)
RUNTIME_MODULES += r8169
endif

## Render ethercat.conf from the template into the repo-local build path
runtime.generate:
	$(QUIET)if [ ! -f "$(RUNTIME_TEMPLATE)" ]; then \
		printf "runtime.generate: FAIL - template not found: %s\n" "$(RUNTIME_TEMPLATE)" >&2; exit 1; \
	fi
	$(QUIET)mkdir -p "$(RUNTIME_BUILD)"
	$(QUIET)sed \
		-e 's|@MASTER0_DEVICE@|$(RUNTIME_MASTER0)|g' \
		-e 's|@MASTER0_BACKUP@|$(RUNTIME_BACKUP)|g' \
		-e 's|@DEVICE_MODULES@|$(strip $(RUNTIME_MODULES))|g' \
		-e 's|@UPDOWN_INTERFACES@|$(strip $(RUNTIME_UPDOWN))|g' \
		"$(RUNTIME_TEMPLATE)" > "$(RUNTIME_OUTPUT)"
	$(QUIET)printf "runtime.generate: OK - wrote %s\n" "$(RUNTIME_OUTPUT)"

## Validate the generated config: required keys present and non-empty master
runtime.lint:
	$(QUIET)out="$(RUNTIME_OUTPUT)"; \
	if [ ! -f "$$out" ]; then \
		printf "runtime.lint: FAIL - generated config not found: %s (run runtime.generate)\n" "$$out" >&2; exit 1; \
	fi; \
	fail=""; \
	for key in MASTER0_DEVICE DEVICE_MODULES UPDOWN_INTERFACES; do \
		if ! grep -q "^$$key=" "$$out"; then \
			fail="$$fail $$key(missing)"; \
		fi; \
	done; \
	master="$$(sed -n 's/^MASTER0_DEVICE="\(.*\)"$$/\1/p' "$$out")"; \
	if [ -z "$$master" ]; then \
		fail="$$fail MASTER0_DEVICE(empty)"; \
	fi; \
	if [ -n "$$fail" ]; then \
		printf "runtime.lint: FAIL -%s\n" "$$fail" >&2; exit 1; \
	fi; \
	printf "runtime.lint: OK - required keys present, master device=%s\n" "$$master"

## Print the generated ethercat.conf (read-only)
runtime.config.show:
	$(QUIET)out="$(RUNTIME_OUTPUT)"; \
	if [ ! -f "$$out" ]; then \
		printf "runtime.config.show: no generated config at %s (run runtime.generate)\n" "$$out" >&2; exit 1; \
	fi; \
	printf "# %s\n" "$$out"; \
	cat "$$out"

## Report the resolved master interface name and its current link state (read-only)
iface.status:
	$(QUIET)PATH="$$PATH:/usr/sbin:/sbin"; iface="$(RUNTIME_MASTER0)"; \
	if [ -z "$$iface" ]; then \
		printf "iface.status: no master interface resolved (ETHERCAT_MASTER0 empty)\n"; exit 0; \
	fi; \
	printf "iface.status: master interface = %s\n" "$$iface"; \
	if command -v ip >/dev/null 2>&1 && ip link show "$$iface" >/dev/null 2>&1; then \
		state="$$(ip -o link show "$$iface" | sed -n 's/.*state \([A-Z]*\).*/\1/p')"; \
		printf "iface.status: link state = %s\n" "$$state"; \
	else \
		printf "iface.status: link state = unknown (interface absent or ip unavailable)\n"; \
	fi

# iface.prepare / iface.unprepare - root-affecting NIC link control for the
# selected-profile interface. The generic driver needs the interface UP before
# the master starts (or all frames time out); on teardown it is brought DOWN.
# The two targets are SYMMETRIC: iface.prepare runs "ip link set <if> up",
# iface.unprepare runs "ip link set <if> down". A DIRECTION override
# (DIRECTION=up | DIRECTION=down) is also honored for callers that want one
# entry point; the default DIRECTION is "up" so a bare iface.prepare brings the
# interface up.
#
# SAFETY CONTRACT:
#   (1) doctor (ip/link tooling on a provisioned host) is a NORMAL prerequisite
#       that exits non-zero on a missing required tool (fail-closed);
#   (2) require-root runs as the FIRST recipe line;
#   (3) the link change is routed through $(SUDO) ip link set;
#   (4) FAIL-CLOSED on an empty/unresolved interface name before any mutation.
# No path is written, so guard-path does not apply (link-state change only).

# Default link direction for iface.prepare. iface.unprepare forces "down".
DIRECTION ?= up

# iface_link DIRECTION
# Shared recipe body. $(1) is the target label for messages; the shell variable
# $$dir carries the link direction. require-root is asserted by the caller as
# the first recipe line; this macro performs the fail-closed interface check and
# the single $(SUDO) ip link mutation.
define iface_link
	PATH="$$PATH:/usr/sbin:/sbin"; iface="$(RUNTIME_MASTER0)"; dir="$(2)"; \
	if [ -z "$$iface" ]; then \
		printf "$(1): FAIL - no interface resolved (ETHERCAT_MASTER0 empty, fail-closed)\n" >&2; exit 1; \
	fi; \
	case "$$dir" in \
		up|down) : ;; \
		*) printf "$(1): FAIL - invalid DIRECTION '%s' (expected up|down, fail-closed)\n" "$$dir" >&2; exit 1;; \
	esac; \
	printf "$(1): bringing interface %s %s\n" "$$iface" "$$dir"; \
	$(SUDO) ip link set "$$iface" "$$dir"
endef

## Bring the selected-profile NIC up (DIRECTION=down to lower) (root-affecting; doctor + require-root)
iface.prepare: doctor.network
	$(QUIET)$(call require-root)
	$(QUIET)$(call iface_link,iface.prepare,$(DIRECTION))

## Bring the selected-profile NIC down (symmetric teardown) (root-affecting; doctor + require-root)
iface.unprepare: doctor.network
	$(QUIET)$(call require-root)
	$(QUIET)$(call iface_link,iface.unprepare,down)

VARS_EXCLUDES+=RUNTIME_MODULES
VARS_EXCLUDES+=iface_link

-include $(TOP)/configure/RULES_RUNTIME.local
