# RULES_DRYRUN - uniform dry-run entry point and structural target listing.
#
# This is a thin, non-root inspection layer. Nothing here mutates host state
# or the source tree; it only re-invokes make in dry-run mode or prints the
# structural target graph for review.

.PHONY: targets

# Re-invoke make in dry-run mode for any target: "make <name>.dryrun" is
# equivalent to "make --dry-run <name>". The stem ($*) is the wrapped target.
%.dryrun:
	$(QUIET) $(MAKE) --dry-run $*

## List the structural target graph grouped by phase
targets:
	$(info --------------------------------------- )
	$(info Structural Target Graph (by phase) )
	$(info --------------------------------------- )
	$(info acquire   : init clone update )
	$(info configure : autoconf src_init src_autoconf )
	$(info profile   : profile.matrix profile.check )
	$(info patch     : patch.status patch.apply patch.reverse patch.make )
	$(info build     : build build.install build.uninstall build.modules )
	$(info module    : dkms.conf module.lifecycle build.dkms add.dkms install.dkms )
	$(info install   : install src_install src_version )
	$(info runtime   : runtime.generate runtime.lint runtime.config.show runtime.status )
	$(info iface     : iface.status iface.prepare iface.unprepare )
	$(info systemd   : systemd.render systemd.install systemd.enable systemd.start )
	$(info systemd   : systemd.stop systemd.disable systemd.remove sd_stop sd_disable sd_clean )
	$(info udev      : udev.render udev.install udev.remove )
	$(info loader    : loader.render loader.install loader.audit )
	$(info command   : command.install command.audit )
	$(info rt        : rt.kernel.provision rt.kernel.select rt.limits.install rt.limits.audit )
	$(info rt        : rt.grub.apply rt.grub.audit rt.grub.rollback rt.clock.status )
	$(info rt        : rt.service.apply rt.service.audit rt.tuned.status rt.status )
	$(info rtdiag    : rt.priority.show rt.priority.apply rt.latency.classify rt.latency.examples )
	$(info remove    : remove.stop remove.disable remove.uninstall remove.rt )
	$(info remove    : remove.purge remove.audit remove.dryrun )
	$(info remove    : uninstall src_uninstall src_version.clean distclean deinit )
	$(info verify    : verify.reproducibility verify.dryrun verify.idempotence verify.residue verify.all )
	$(info dry-run   : <name>.dryrun targets )
	@:
