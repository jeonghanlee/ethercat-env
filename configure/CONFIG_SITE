
### $APPNAME installation location
INSTALL_PATH=/opt
INSTALL_LOCATION=$(INSTALL_PATH)/$(APPNAME)

### Installed-file ownership (override in CONFIG_SITE.local)
USERID:=$(shell id -un)
GROUPID:=$(shell id -gn)

# Resume old file, and use it as a reference
# WITH_PATCHSET:=NO

# Device Options
# option: --enable-generic        Enable generic Ethernet driver
# option: --enable-8139too        Enable 8139too driver
# option: --enable-e100           Enable e100 driver
# option: --enable-e1000          Enable e1000 driver
# option:  --enable-e1000e         Enable e1000e driver
#       :  --enable-genet          Enable genet driver (for Raspi 4)
# option:  --enable-igb            Enable igb driver
#       :  --enable-igc            Enable igc driver
# option:  --enable-r8169          Enable r8169 driver
#       :  --enable-stmmac-pci     Enable stmmac driver
#       : --enable-dwmac-intel    Enable stmmac driver
# option: --enable-ccat           Enable CCAT driver
#       : --enable-rtdm           Enable RTDM interface, depends on RTAI or Xenomai
#       : --enable-debug-if       Create a debug interface for each master [NO]
#       : --enable-debug-ring     Create a debug ring to record frames [NO]
# option: --enable-eoe            Enable EoE support (default: yes)
# option: --enable-cycles         Use CPU timestamp counter (default: no)
# option: --enable-hrtimer        Use high-resolution timer for scheduling (default:


WITH_DEV_GENERIC:=YES
#WITH_DEV_8139TOO:=NO
#WITH_DEV_E100:=NO
#WITH_DEV_E1000:=NO
#WITH_DEV_E1000E:=NO
#WITH_DEV_IGB:=NO
WITH_DEV_R8169:=YES
#WITH_DEV_CCAT:=NO

ENABLE_STATIC:=YES
ENABLE_SHARED:=YES

# ENABLE_EOE:=NO
# Intel Architecture
ENABLE_CYCLES:=YES
# ENABLE_HRTIMER:=NO
ENABLE_REGALIAS:=NO


#  --enable-regalias       Read alias adresses from register (default: no)
#  --enable-tool           Build command-line tool (default: yes)
#  --enable-userlib        Generation of the userspace library (default: yes)
#  --enable-fakeuserlib    Generation of the userspace library (default: no)
#  --enable-tty            Generation of the ec_tty module (default: no)
#  --enable-wildcards      Enable vendor ID / product code wildcards (default: no)
#  --enable-sii-assign     Enable SII assignment to PDI (default: yes)
#  --enable-rt-syslog      Enable RT syslog (default: yes)
#  --disable-initd         Disable /etc/init.d script support (default:  enabled)

ENABLE_TOOL:=YES
ENABLE_USERLIB:=YES
ENABLE_SII_ASSIGN:=YES
ENABLE_RT_SYSLOG:=YES


# This is only valid when WITH_PATCHSET=YES
#
# ENABLE_RTMUTEX:=NO


# These allow developers to override the CONFIG_SITE variable
# settings without having to modify the configure/CONFIG_SITE
# file itself.
-include $(TOP)/../CONFIG_SITE.local
-include $(TOP)/configure/CONFIG_SITE.local
