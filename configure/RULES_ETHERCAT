.PHONY: autoconf src_init src_autoconf build.baseline host.debian13

# build.baseline - order-only umbrella documenting the reproducible build path
# as one named entry point: verify the pinned revision (M2) BEFORE configure,
# then run the existing autoconf -> build -> build.modules sequence. The
# prerequisites are listed in build order; src.verify is first so a moved
# branch fails the baseline before any configure or compile runs. Non-root:
# every step is configure/build inside $(SRC_PATH); no install.
## Reproducible build path: src.verify then autoconf, build, build.modules
build.baseline: src.verify autoconf build build.modules
	$(QUIET)printf "build.baseline: OK - verified revision configured, built, and modules built\n"

# host.debian13 - non-fatal report of detected OS name/version against the
# Debian 13 expectation recorded in CONFIG_SRC. This is the lightweight
# report only; the hard fail belongs to the M5 doctor layer. It never exits
# non-zero, so it does not gate the tree.
## Report detected OS name/version vs expected Debian 13 (non-fatal)
host.debian13:
	$(QUIET)exp_name="$(EXPECTED_OS_NAME)"; exp_ver="$(EXPECTED_OS_VERSION)"; \
	det_name="$(OS_NAME)"; det_ver="$(OS_VERSION)"; det_major="$${det_ver%%.*}"; \
	printf ">> Expected OS : %s %s\n" "$$exp_name" "$$exp_ver"; \
	printf ">> Detected OS : %s %s\n" "$$det_name" "$$det_ver"; \
	if [ "$$det_name" = "$$exp_name" ] && [ "$$det_major" = "$$exp_ver" ]; then \
		printf "host.debian13: match\n"; \
	else \
		printf "host.debian13: MISMATCH (report only, non-fatal)\n"; \
	fi

# profile.check is listed FIRST so the fail-closed evidence gate runs before
# src_autoconf (which itself invokes ./configure). An enabled native profile
# without kernel + upstream-source evidence aborts before any configure runs.
autoconf: profile.check src_init src_autoconf
	cd $(SRC_PATH) && ./configure $(ETHERCAT_OPTIONS) --prefix=$(INSTALL_LOCATION)

src_init:
	$(QUIET) cd $(SRC_PATH) && touch ChangeLog

src_autoconf:
	cd $(SRC_PATH) && autoreconf --force --install -v && ./configure $(ETHERCAT_OPTIONS) --prefix=$(INSTALL_LOCATION)


.PHONY: autoconf build build.install build.uninstall clean build.modules install.modules uninstall.modules build.dkms add.dkms remove.dkms install.dkms uninstall.dkms dkms.conf module.lifecycle

# DO_MAKE in CONFIG_SRC
#
build:
	$(DO_MAKE)

# Upstream "make install" wrapper. Renamed from a bare "install" so it no
# longer collides with the prefix-tree installer in RULES_INSTALL.
build.install: build
	$(DO_MAKE) install

# Upstream "make uninstall" wrapper. Renamed from a bare "uninstall" so it no
# longer collides with the prefix-tree uninstaller in RULES_INSTALL.
build.uninstall:
	$(DO_MAKE) uninstall

clean:
	$(DO_MAKE) clean

# ---------------------------------------------------------------------------
# M8 - Kernel module lifecycle.
#
# Delegated decision D1: DKMS is the recorded PRODUCTION lifecycle (modules
# auto-rebuild on a Debian 13 kernel update). build.modules / install.modules
# are retained as the DEVELOPER build path. module.lifecycle records this.
#
# SAFETY CONTRACT for every root-affecting module target below:
#   (1) doctor.kernel / doctor.tools (dkms + depmod present) is a NORMAL
#       prerequisite that exits non-zero on a missing required tool (fail-closed);
#   (2) require-root runs as the FIRST recipe line;
#   (3) every host mutation (dkms install/add/remove, make modules install/
#       uninstall, depmod -a) is routed through $(SUDO);
#   (4) depmod -a is never bare - it always runs as $(SUDO) depmod -a after the
#       doctor + require-root preconditions.
# Non-root targets (build.modules, build.dkms, dkms.conf, module.lifecycle)
# touch only the source tree and carry no require-root.
# ---------------------------------------------------------------------------

# Modules - DEVELOPER build path (non-root: builds inside $(SRC_PATH) only).
build.modules:
	$(DO_MAKE) modules

clean.modules:
	$(DO_MAKE) clean

# Root-affecting: writes into /lib/modules and runs depmod -a. Routed through
# $(SUDO); doctor.kernel hard prerequisite; require-root first.
install.modules: doctor.kernel
	$(QUIET)$(call require-root)
	$(SUDO) $(DO_MAKE) modules install
	$(QUIET)$(SUDO) depmod -a

# Root-affecting: removes from /lib/modules and runs depmod -a.
uninstall.modules: doctor.kernel
	$(QUIET)$(call require-root)
	$(SUDO) $(DO_MAKE) modules uninstall
	$(QUIET)$(SUDO) depmod -a

# DKMS lifecycle.
#
# dkms.conf - NON-ROOT. Generates the DKMS metadata file INTO the source tree
# ($(DKMS_CONF)), not into /var/lib/dkms or /usr/src. Built-module entries are
# emitted per enabled device profile (index 1..N), after the static master
# module (index 0) carried by the template.
## Generate dkms.conf into the source tree from MODULE_NAME / MODULE_VERSION (non-root)
dkms.conf:
	$(QUIET)if [ ! -f "$(DKMS_CONF_TEMPLATE)" ]; then \
		printf "dkms.conf: FAIL - template not found: %s\n" "$(DKMS_CONF_TEMPLATE)" >&2; exit 1; \
	fi
	$(QUIET)if [ ! -d "$(DKMS_SRC_TREE)" ]; then \
		printf "dkms.conf: FAIL - source tree not found: %s (run make init)\n" "$(DKMS_SRC_TREE)" >&2; exit 1; \
	fi
	$(QUIET)idx=0; devlines=""; \
	for d in $(strip $(DKMS_DEVICE_MODULES)); do \
		idx=$$((idx+1)); \
		devlines="$$devlines"'BUILT_MODULE_NAME['"$$idx"']="ec_'"$$d"'"\n'; \
		devlines="$$devlines"'BUILT_MODULE_LOCATION['"$$idx"']="devices"\n'; \
		devlines="$$devlines"'DEST_MODULE_LOCATION['"$$idx"']="/kernel/drivers/ethercat"\n'; \
	done; \
	sed \
		-e 's|@MODULE_NAME@|$(MODULE_NAME)|g' \
		-e 's|@MODULE_VERSION@|$(MODULE_VERSION)|g' \
		-e "s|@BUILT_DEVICE_MODULES@|$$devlines|" \
		"$(DKMS_CONF_TEMPLATE)" | sed -e 's|\\n|\n|g' > "$(DKMS_CONF)"
	$(QUIET)printf "dkms.conf: OK - wrote %s (-m %s -v %s)\n" "$(DKMS_CONF)" "$(MODULE_NAME)" "$(MODULE_VERSION)"

# build.dkms - NON-ROOT developer convenience: builds the registered module via
# DKMS without installing it. No host module tree is touched, so no require-root.
build.dkms:
	$(DKMS) build -m $(MODULE_NAME) -v $(MODULE_VERSION)
#	$(DKMS) build -m $(MODULE_NAME) -v $(MODULE_VERSION) --verbose

# Root-affecting: stages the generated source tree into /usr/src and registers
# it with DKMS. The "dkms add -m -v" form requires the source at
# $(DKMS_USR_SRC), so the source tree (carrying dkms.conf) is copied there first.
add.dkms: doctor.tools
	$(QUIET)$(call require-root)
	$(QUIET)test -f "$(DKMS_CONF)" || { printf "add.dkms: FAIL - %s not found (run make dkms.conf)\n" "$(DKMS_CONF)" >&2; exit 1; }
	$(QUIET)case "$(DKMS_USR_SRC)" in /usr/src/$(MODULE_NAME)-*) ;; *) printf "add.dkms: FAIL - unsafe DKMS_USR_SRC=%s\n" "$(DKMS_USR_SRC)" >&2; exit 1 ;; esac
	$(SUDO) rm -rf "$(DKMS_USR_SRC)"
	$(SUDO) cp -r "$(abspath $(DKMS_SRC_TREE))" "$(DKMS_USR_SRC)"
	$(SUDO) $(DKMS) add -m $(MODULE_NAME) -v $(MODULE_VERSION)

# Root-affecting: removes the registration from /var/lib/dkms and the staged
# source tree from /usr/src.
remove.dkms: doctor.tools
	$(QUIET)$(call require-root)
	$(SUDO) $(DKMS) remove -m $(MODULE_NAME) -v $(MODULE_VERSION) --all
	$(QUIET)case "$(DKMS_USR_SRC)" in /usr/src/$(MODULE_NAME)-*) $(SUDO) rm -rf "$(DKMS_USR_SRC)" ;; esac

# Root-affecting: installs the built module into /lib/modules and runs depmod -a.
install.dkms: doctor.kernel
	$(QUIET)$(call require-root)
	$(SUDO) $(DKMS) install -m $(MODULE_NAME) -v $(MODULE_VERSION) --force
	$(QUIET)$(SUDO) depmod -a

# Root-affecting: uninstalls the module from /lib/modules and runs depmod -a.
uninstall.dkms: doctor.kernel
	$(QUIET)$(call require-root)
	$(SUDO) $(DKMS) uninstall -m $(MODULE_NAME) -v $(MODULE_VERSION)
	$(QUIET)$(SUDO) depmod -a

# module.lifecycle - NON-ROOT, read-only. Prints the recorded strategy (DKMS per
# D1) and the kernel-update rebuild expectation, plus the developer-path note.
## Print the recorded module lifecycle strategy (DKMS) - read-only
module.lifecycle:
	$(QUIET)printf "module.lifecycle: recorded strategy = DKMS (delegated decision D1)\n"
	$(QUIET)printf "  module identity      : -m %s -v %s\n" "$(MODULE_NAME)" "$(MODULE_VERSION)"
	$(QUIET)printf "  source tree          : %s\n" "$(DKMS_SRC_TREE)"
	$(QUIET)printf "  dkms.conf            : %s\n" "$(DKMS_CONF)"
	$(QUIET)printf "  /usr/src registration: %s\n" "$(DKMS_USR_SRC)"
	$(QUIET)printf "  kernel-update behavior: modules auto-rebuild on a Debian 13 kernel update (AUTOINSTALL=yes)\n"
	$(QUIET)printf "  developer path       : build.modules / install.modules retained (NOT the production lifecycle)\n"




