# RULES_VERIFY — repository-local verification harness (M14).
#
# The entire harness is dry-run / inspection / lint. It performs no install, no
# module load, no GRUB edit, no service start, no host mutation. Its job is to
# assert that the OTHER milestones' guards are present, and to act as the
# regression gate for the root-affecting milestones (M8-M13) as they land.
#
# Scope registries
# ----------------
# VERIFY_ROOT_TARGETS       root-affecting targets that must reference both
#                           `doctor` (or a scoped doctor) and `require-root` in
#                           their expanded dry-run output.
# VERIFY_GUARDPATH_TARGETS  the subset that additionally runs `rm` or writes
#                           under a path prefix; these must ALSO reference
#                           `guard-path`. Targets whose mutation is depmod -a /
#                           ldconfig / update-grub / systemctl are gated by
#                           doctor + require-root only (no guard-path).
#
# Each milestone appends its own targets to these lists via RULES_VERIFY.local or
# an inline edit when the milestone lands. Today only M9 iface.prepare is wired;
# M8/M10/M11/M13 extend the lists as they are applied. The harness checks exactly
# the registered set, so it never asserts a guard against a not-yet-hardened
# target.

.PHONY: verify.reproducibility verify.dryrun verify.idempotence verify.residue verify.all

# Root-affecting targets in scope for the currently-applied milestones.
# M9  : iface.prepare / iface.unprepare (ip link, no path write).
# M8  : module install/uninstall + DKMS add/remove/install/uninstall. Their
#       mutation is depmod -a / dkms, so per the M14 policy they need
#       doctor + require-root only (no guard-path).
# M10 : systemctl / udevadm / ldconfig service-and-loader lifecycle. enable /
#       start / stop / disable / sd_stop / sd_disable mutate via systemctl only,
#       so they too are doctor + require-root only (no guard-path).
# M11 : rt.kernel.provision (apt install, no path write) and rt.service.apply
#       (systemctl mask on the allowlist, no path write) are doctor +
#       require-root only.
# M13 : remove.stop / remove.disable delegate to sd_stop / sd_disable (systemctl
#       only), so they are doctor + require-root only.
#
# M12 : rt.priority.apply changes scheduling class via $(SUDO) chrt (no path
#       write), so it is doctor + require-root only. It depends on the scoped
#       doctor.rtdiag (chrt present) for consistency with every other
#       root-affecting target; its fail-closed named-TARGET check remains the
#       controlling guard on WHICH process is changed.
VERIFY_ROOT_TARGETS      ?= \
	iface.prepare iface.unprepare \
	install.modules uninstall.modules \
	add.dkms remove.dkms install.dkms uninstall.dkms \
	systemd.enable systemd.start systemd.stop systemd.disable \
	sd_stop sd_disable \
	rt.kernel.provision rt.service.apply \
	rt.priority.apply \
	remove.stop remove.disable
# Of those, the path-prefix-write / rm targets that must ALSO carry guard-path.
# src_* carry guard-path from M2/M4. M10 *.install / *.remove / sd_clean write or
# remove under a path prefix (/etc/systemd/system, /etc/udev/rules.d, /usr/bin,
# /etc/ld.so.conf.d), so each must show guard-path ahead of the write/rm.
# M11 rt.limits.install / rt.grub.apply / rt.grub.rollback write or restore under
# a path prefix (/etc/security/limits.d, /etc/default/grub and its backup), so
# each must show guard-path. M13 remove.uninstall / remove.rt / remove.purge run
# rm under a path prefix, so each must show guard-path.
# iface.prepare / module / dkms / systemctl-only / apt-only targets write no path
# and are intentionally absent here.
VERIFY_GUARDPATH_TARGETS ?= \
	src_install src_uninstall src_version src_version.clean \
	systemd.install systemd.remove sd_clean \
	udev.install udev.remove \
	command.install loader.install \
	rt.limits.install rt.grub.apply rt.grub.rollback \
	remove.uninstall remove.rt remove.purge

# The recursive dry-run captures below run with -j1. The harness is inspection-
# only, and a parallel jobserver lets recursive sub-makes interleave and
# occasionally drop a prerequisite's recipe line from a captured dry-run, which
# would produce a spurious guard FAIL. Serial sub-makes make the capture
# deterministic; correctness, not speed, governs the verification harness.
VERIFY_DRYRUN = $(MAKE) -j1 --no-print-directory --dry-run

## Assert the pinned revision is reachable (src.verify) — non-hardware
verify.reproducibility:
	$(QUIET)printf "verify.reproducibility: checking pinned revision via src.verify\n"
	$(QUIET)$(MAKE) --no-print-directory src.verify
	$(QUIET)printf "verify.reproducibility: OK — init would reach the pinned revision\n"

## Assert every registered root-affecting target is guarded in its dry-run
verify.dryrun:
	$(QUIET)rc=0; \
	for t in $(VERIFY_ROOT_TARGETS); do \
		out="$$($(VERIFY_DRYRUN) $$t 2>/dev/null)"; \
		if [ -z "$$out" ]; then \
			printf "verify.dryrun: FAIL — %s produced empty dry-run\n" "$$t" >&2; rc=1; continue; \
		fi; \
		case "$$out" in \
			*doctor:*|*doctor[[]*) : ;; \
			*) printf "verify.dryrun: FAIL — %s dry-run lacks a doctor reference\n" "$$t" >&2; rc=1;; \
		esac; \
		case "$$out" in \
			*require-root:*) : ;; \
			*) printf "verify.dryrun: FAIL — %s dry-run lacks require-root\n" "$$t" >&2; rc=1;; \
		esac; \
		if [ "$$rc" -eq 0 ]; then printf "verify.dryrun: OK   — %s (doctor + require-root)\n" "$$t"; fi; \
	done; \
	for t in $(VERIFY_GUARDPATH_TARGETS); do \
		out="$$($(VERIFY_DRYRUN) $$t 2>/dev/null)"; \
		if [ -z "$$out" ]; then \
			printf "verify.dryrun: FAIL — %s produced empty dry-run\n" "$$t" >&2; rc=1; continue; \
		fi; \
		case "$$out" in \
			*guard-path:*) printf "verify.dryrun: OK   — %s (guard-path)\n" "$$t";; \
			*) printf "verify.dryrun: FAIL — %s writes a path but lacks guard-path\n" "$$t" >&2; rc=1;; \
		esac; \
	done; \
	if [ "$$rc" -ne 0 ]; then exit 1; fi; \
	printf "verify.dryrun: OK — all registered targets guarded\n"

## Assert repeated dry-run output for registered targets is byte-stable
verify.idempotence:
	$(QUIET)rc=0; \
	for t in $(VERIFY_ROOT_TARGETS) $(VERIFY_GUARDPATH_TARGETS); do \
		a="$$($(VERIFY_DRYRUN) $$t 2>/dev/null)"; \
		b="$$($(VERIFY_DRYRUN) $$t 2>/dev/null)"; \
		if [ "$$a" != "$$b" ]; then \
			printf "verify.idempotence: FAIL — %s dry-run not stable across runs\n" "$$t" >&2; rc=1; \
		else \
			printf "verify.idempotence: OK   — %s stable\n" "$$t"; \
		fi; \
	done; \
	if [ "$$rc" -ne 0 ]; then exit 1; fi; \
	printf "verify.idempotence: OK — registered dry-runs stable\n"

# remove.audit emits a single machine-readable final verdict line
# (remove.audit: VERDICT=clean | VERDICT=residue). The matcher keys on that
# verdict, NOT on a substring scan of the whole report — the report header and
# per-item lines legitimately contain the word "residue", so a substring scan
# would false-positive on a clean run.
## Assert remove.audit (M13) reports no residue; skip cleanly until M13 lands
verify.residue:
	$(QUIET)if $(MAKE) --no-print-directory -n remove.audit >/dev/null 2>&1; then \
		verdict="$$($(MAKE) --no-print-directory remove.audit 2>/dev/null | sed -n 's/^remove.audit: VERDICT=//p')"; \
		case "$$verdict" in \
			clean)   printf "verify.residue: OK — remove.audit reports no residue\n";; \
			residue) printf "verify.residue: FAIL — remove.audit reports residue\n" >&2; exit 1;; \
			*)       printf "verify.residue: FAIL — remove.audit emitted no parseable VERDICT\n" >&2; exit 1;; \
		esac; \
	else \
		printf "verify.residue: SKIP — remove.audit not defined yet (M13 pending)\n"; \
	fi

## Umbrella regression gate over the harness
verify.all: verify.reproducibility verify.dryrun verify.idempotence verify.residue
	$(QUIET)printf "verify.all: OK — repository-local verification harness passed\n"

VARS_EXCLUDES += VERIFY_DRYRUN

-include $(TOP)/configure/RULES_VERIFY.local
